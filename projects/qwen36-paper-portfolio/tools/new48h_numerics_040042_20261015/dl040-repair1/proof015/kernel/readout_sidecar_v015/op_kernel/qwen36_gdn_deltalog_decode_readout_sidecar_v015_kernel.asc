#include "qwen36_gdn_deltalog_decode_readout_sidecar_v015.h"
#include "qwen36_gdn_deltalog_decode_readout_sidecar_v015_tiling.h"

using namespace AscendC;
using namespace Qwen36DeltaLogReadoutSidecarV015;

extern "C" __global__ __vector__ void qwen36_gdn_deltalog_decode_readout_sidecar_v015_kernel(
    GM_ADDR query,
    GM_ADDR key,
    GM_ADDR value,
    GM_ADDR g,
    GM_ADDR beta,
    GM_ADDR baseState,
    GM_ADDR kLog,
    GM_ADDR uLog,
    GM_ADDR lambdaLog,
    GM_ADDR cumulativeDecay,
    GM_ADDR logLength,
    GM_ADDR actualSeqLengths,
    GM_ADDR stateIndices,
    GM_ADDR out,
    GM_ADDR precastFP32,
    GM_ADDR tilingGM)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    const __gm__ DeltalogTilingData *tiling =
        reinterpret_cast<const __gm__ DeltalogTilingData *>(tilingGM);
    DeltaLogKernel op(tiling);
    DeltaLogInitParams params{
        query, key, value, g, beta, baseState, kLog, uLog, lambdaLog,
        cumulativeDecay, logLength, actualSeqLengths, stateIndices, out, precastFP32};
    op.Init(params, &pipe);
    op.Process();
}
