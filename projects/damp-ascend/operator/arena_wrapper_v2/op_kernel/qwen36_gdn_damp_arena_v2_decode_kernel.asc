#include "kernel_operator.h"
#include "../../production_integer_compaction_v1/op_kernel/qwen36_gdn_damp_integer_compaction_v1_decode_tiling.h"
#if defined(__NPU_ARCH__)
#include "../../production_integer_compaction_v1/op_kernel/qwen36_gdn_damp_integer_compaction_v1_decode.h"
#endif

using namespace AscendC;
using namespace Qwen36DampIntegerCompactionV1;

extern "C" __global__ __vector__ void qwen36_gdn_damp_arena_v2_decode_kernel(
    GM_ADDR query, GM_ADDR key, GM_ADDR value, GM_ADDR g, GM_ADDR beta,
    GM_ADDR highState, GM_ADDR lowState, GM_ADDR lowScale,
    GM_ADDR pk, GM_ADDR pv, GM_ADDR invPv, GM_ADDR sr,
    GM_ADDR actualSeqLengths, GM_ADDR stateIndices,
    GM_ADDR out, GM_ADDR tilingGM)
{
#if defined(__NPU_ARCH__)
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    const __gm__ DampTilingData* tiling =
        reinterpret_cast<const __gm__ DampTilingData*>(tilingGM);
    DampKernel op(tiling);
    DampInitParams params{
        query, key, value, g, beta, highState, lowState, lowScale,
        pk, pv, invPv, sr, actualSeqLengths, stateIndices, out};
    op.Init(params, &pipe);
    op.Process();
#endif
}
