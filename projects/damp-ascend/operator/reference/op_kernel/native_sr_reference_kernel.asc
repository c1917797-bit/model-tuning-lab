#include "native_sr_reference.h"
using namespace AscendC;
using namespace Qwen36DampReference;
extern "C" __global__ __vector__ void qwen36_damp_native_sr_reference_kernel(
    GM_ADDR q, GM_ADDR k, GM_ADDR v, GM_ADDR g, GM_ADDR beta,
    GM_ADDR selectedState, GM_ADDR pk, GM_ADDR pv, GM_ADDR invPv, GM_ADDR sr,
    GM_ADDR updated, GM_ADDR fpOut, GM_ADDR bfOut, uint32_t tokens, float qScale)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    NativeSrReference op(tokens, qScale);
    ReferenceInputs p{q, k, v, g, beta, selectedState, pk, pv, invPv, sr, updated, fpOut, bfOut};
    op.Init(p, &pipe);
    op.Process();
}
