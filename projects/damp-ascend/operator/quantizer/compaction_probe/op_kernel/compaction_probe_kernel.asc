#include "kernel_operator.h"
#include "probe_plan.h"
// Host pass MUST see the global definition (not just a declaration); otherwise
// ASC may link an unresolved launch symbol. Only device-only body is guarded.
#if defined(__NPU_ARCH__)
#include "compaction_probe.h"
#endif
extern "C" __global__ __vector__ void qwen36_damp_compaction_kernel(
    GM_ADDR accepted, GM_ADDR x, GM_ADDR scale, GM_ADDR magnitude,
    GM_ADDR code, GM_ADDR indices, GM_ADDR retained, GM_ADDR valid, GM_ADDR tilingGm)
{
#if defined(__NPU_ARCH__)
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    AscendC::TPipe pipe;
    DampCompactionProbe::Kernel op;
    op.Init(accepted,x,scale,magnitude,code,indices,retained,valid,
        reinterpret_cast<const __gm__ DampCompactionProbe::Tiling*>(tilingGm),&pipe);
    op.Process();
#endif
}
