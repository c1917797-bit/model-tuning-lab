#include "quantizer_probe.h"
extern "C" __global__ __vector__ void qwen36_damp_quantizer_exact_bits_kernel(
    GM_ADDR x, GM_ADDR scale, GM_ADDR codes, GM_ADDR valid, GM_ADDR tilingGm)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    AscendC::TPipe pipe;
    Qwen36DampQuantizerProbe::ExactBitsKernel op;
    op.Init(x, scale, codes, valid,
        reinterpret_cast<const __gm__ Qwen36DampQuantizerProbe::Tiling*>(tilingGm),
        &pipe);
    op.Process();
}
