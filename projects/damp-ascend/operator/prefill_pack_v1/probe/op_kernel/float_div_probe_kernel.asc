#include "kernel_operator.h"
#include "probe_plan.h"
// Host-visible annotated definition is required to emit the exported launcher.
// Only the device implementation include/body is hidden from the ASC host pass.
#if defined(__NPU_ARCH__)
#include "float_div_probe.h"
#endif
extern "C" __global__ __vector__ void qwen36_damp_prefill_float_div_bits_kernel(
    GM_ADDR x,GM_ADDR sr,GM_ADDR proposal,GM_ADDR bits,GM_ADDR valid,
    GM_ADDR finite,GM_ADDR certified,GM_ADDR tilingGm)
{
#if defined(__NPU_ARCH__)
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    AscendC::TPipe pipe;
    DampPrefillFloatProbe::Kernel op;
    op.Init(x,sr,proposal,bits,valid,finite,certified,
        reinterpret_cast<const __gm__ DampPrefillFloatProbe::Tiling*>(tilingGm),&pipe);
    op.Process();
#endif
}
