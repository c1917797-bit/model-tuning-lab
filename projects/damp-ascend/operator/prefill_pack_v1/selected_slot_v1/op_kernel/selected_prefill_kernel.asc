#include "kernel_operator.h"
#include "prefill_plan.h"
#if defined(__NPU_ARCH__)
#include "selected_prefill.h"
#endif
extern "C" __global__ __vector__ void qwen36_damp_selected_prefill_pack_kernel(
    GM_ADDR dense,GM_ADDR high,GM_ADDR low,GM_ADDR scales,GM_ADDR pk,
    GM_ADDR pv,GM_ADDR sr,GM_ADDR indices,GM_ADDR status,GM_ADDR tilingGm)
{
#if defined(__NPU_ARCH__)
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    AscendC::TPipe pipe;
    Qwen36DampSelectedPrefill::Kernel op(
        reinterpret_cast<const __gm__ Qwen36DampSelectedPrefill::Tiling*>(tilingGm));
    op.Init(dense,high,low,scales,pk,pv,sr,indices,status,&pipe);
    op.Process();
#endif
}
