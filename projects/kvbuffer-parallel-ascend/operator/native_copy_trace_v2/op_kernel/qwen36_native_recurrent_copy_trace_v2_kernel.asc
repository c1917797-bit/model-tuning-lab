#include "recurrent_gated_delta_rule_copy_trace.h"
using namespace AscendC;
extern "C" __global__ __aicore__ void qwen36_native_recurrent_copy_trace_v2_kernel(
 GM_ADDR q,GM_ADDR k,GM_ADDR v,GM_ADDR g,GM_ADDR beta,GM_ADDR state,
 GM_ADDR seq,GM_ADDR idx,GM_ADDR out,GM_ADDR precast,GM_ADDR selected,GM_ADDR tiling)
{
 NativeRecurrentCopyTraceV2::NativeRecurrentCopyTraceV2TilingData data;
 uint32_t* dst=reinterpret_cast<uint32_t*>(&data);
 __gm__ uint32_t* src=reinterpret_cast<__gm__ uint32_t*>(tiling);
 for(uint32_t i=0;i<sizeof(data)/sizeof(uint32_t);++i)dst[i]=src[i];
 TPipe pipe;
 NativeRecurrentCopyTraceV2::RGDRInitParams args{q,k,v,g,nullptr,beta,state,seq,idx,nullptr,out,state,precast,selected};
 NativeRecurrentCopyTraceV2::RGDR<bfloat16_t,bfloat16_t,float> op(&data);
 op.Init(args,&pipe);op.Process();
}
