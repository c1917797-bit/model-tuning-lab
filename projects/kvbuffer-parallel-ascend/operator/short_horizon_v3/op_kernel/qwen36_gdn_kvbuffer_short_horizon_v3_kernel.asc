#include "qwen36_gdn_kvbuffer_short_horizon_v3.h"
#include "qwen36_gdn_kvbuffer_short_horizon_v3_tiling.h"

using namespace AscendC;
using namespace Qwen36KVBufferShortHorizonV3;

extern "C" __global__ __vector__ void qwen36_gdn_kvbuffer_short_horizon_v3_kernel(
    GM_ADDR query,
    GM_ADDR key,
    GM_ADDR value,
    GM_ADDR g,
    GM_ADDR beta,
    GM_ADDR baseState,
    GM_ADDR kLog,
    GM_ADDR uLog,
    GM_ADDR lambdaLog,
    GM_ADDR cumulativeDecay,
    GM_ADDR logLength,
    GM_ADDR actualSeqLengths,
    GM_ADDR stateIndices,
    GM_ADDR out,
    GM_ADDR tilingGM)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    const __gm__ KVBufferTilingData *tiling =
        reinterpret_cast<const __gm__ KVBufferTilingData *>(tilingGM);
    KVBufferKernel op(tiling);
    KVBufferInitParams params{
        query, key, value, g, beta, baseState, kLog, uLog, lambdaLog,
        cumulativeDecay, logLength, actualSeqLengths, stateIndices, out};
    op.Init(params, &pipe);
    op.Process();
}
