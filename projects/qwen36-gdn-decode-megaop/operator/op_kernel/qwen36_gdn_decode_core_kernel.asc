/*!
 * \file recurrent_gated_delta_rule.cpp
 * \brief
 */
#include "qwen36_gdn_decode_core.h"
#include "qwen36_gdn_decode_core_tiling.h"

using namespace AscendC;
using namespace RecurrentGatedDeltaRule;

extern "C" __global__ __vector__ void qwen36_gdn_decode_core_kernel(
    GM_ADDR query,
    GM_ADDR key,
    GM_ADDR value,
    GM_ADDR aLog,
    GM_ADDR a,
    GM_ADDR b,
    GM_ADDR dtBias,
    GM_ADDR state,
    GM_ADDR cuSeqlens,
    GM_ADDR ssmStateIndices,
    GM_ADDR out,
    GM_ADDR tilingGM)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    const __gm__ RecurrentGatedDeltaRuleTilingData *tilingData =
        (__gm__ RecurrentGatedDeltaRuleTilingData *)tilingGM;
    RGDR<bfloat16_t, bfloat16_t, float> op(tilingData);
    RGDRInitParams initParams{
        query,
        key,
        value,
        aLog,
        a,
        b,
        dtBias,
        state,
        cuSeqlens,
        ssmStateIndices,
        out,
        state,
    };
    op.Init(initParams, &pipe);
    op.Process();
}
